# =============================================================================
# TATİL'ER - KÜRESEL ARBİTRAJ & SEYAHAT PORTALI (BACKEND ENV TEMPLATE)
# =============================================================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Credentials (Public Anon Key is safe for client, Service Key if needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# RapidAPI (Flights & Hotels Scraper)
# Sign up at: https://rapidapi.com/ntd119/api/flights-sky
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=flights-sky.p.rapidapi.com

# SerpApi (Google Flights Live Search)
# Sign up at: https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Amadeus Flight API (Optional Fallback)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_HOSTNAME=test.api.amadeus.com

# Turkish Customs Regulatory Parameters (2025/2026)
IMEI_FEE_TRY=45614.00
TRT_BANDROL_PHONE_EUR=20.00
TRT_BANDROL_MONITOR_EUR=10.00
