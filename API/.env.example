# =============================================================================
# ARBITRIP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your own credentials:
#   copy .env.example .env
# =============================================================================

# Supabase Project Configuration (https://supabase.com)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_or_publishable_key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Autonomous Scraping Schedule (UTC)
CRON_SCHEDULE="0 2 * * *"
SCRAPER_WINDOW_MINUTES=180

# Proxy & Cloud Bypass Configuration
# Supported providers: "scraperapi" | "brightdata" | "oxylabs" | "direct"
PROXY_PROVIDER="scraperapi"
SCRAPER_API_KEY="your_scraperapi_key_here"

# Optional Residential Proxy Credentials (for Bright Data / Oxylabs)
PROXY_HOST=""
PROXY_PORT=""
PROXY_USERNAME=""
PROXY_PASSWORD=""

# Concurrency & Polite Crawling Settings
MAX_CONCURRENT_REQUESTS=5
PER_DOMAIN_DELAY_MS=2500

# Headless Browser Options (Puppeteer Stealth)
HEADLESS_MODE=true
MAX_BROWSER_PAGES_PER_INSTANCE=50
