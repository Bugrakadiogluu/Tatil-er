# =============================================================================
# TATİL'ER - KÜRESEL ARBİTRAJ & SEYAHAT PORTALI (ROOT ENV TEMPLATE)
# =============================================================================

# Server Ports & URLs
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Supabase / PostgreSQL Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgres://arbitrip_admin:arbitrip_secure_password_2026@localhost:5432/arbitrip_db

# Flight & Travel APIs
AMADEUS_CLIENT_ID=your_amadeus_api_key_here
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret_here
AMADEUS_HOSTNAME=test.api.amadeus.com
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=flights-sky.p.rapidapi.com
SERPAPI_KEY=your_serpapi_key_here

# Turkish Customs Regulatory Parameters (2025/2026)
IMEI_FEE_TRY=45614.00
TRT_BANDROL_PHONE_EUR=20.00
TRT_BANDROL_MONITOR_EUR=10.00
